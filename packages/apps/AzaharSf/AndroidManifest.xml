<?xml version="1.0" encoding="utf-8"?>
<!-- AzaharSf: starts azahar-nano (the Nintendo 3DS emulator of the GammaOS Nano shell) from
     normal Android. Daijishō launches it for a 3DS ROM:
       -n com.gammaos.azaharsf/.AzaharSfActivity -e ROM {file.path} -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gammaos.azaharsf"
    android:sharedUserId="android.uid.system">

    <application
        android:allowBackup="false"
        android:label="Nintendo 3DS (azahar-nano)"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".AzaharSfActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="nosensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Daijishō takes the package from the player's "-n <package>/" and treats the
                 player as installed only if that package is among the MAIN + LAUNCHER
                 activities (DaijishouLibraryModel.getLauncherIntent, the list its Apps tab is
                 built from); otherwise "does not exist on your device". So the host has a
                 launcher icon; opened without a ROM it says where 3DS games start from. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
