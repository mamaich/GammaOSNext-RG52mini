<!-- RG52 Mini: the console as a wired Xbox 360 controller for a PC (rg52-xpad), chosen on the
     USB screen next to the USB functions. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="rg52_usb_use_game_controller">Game controller for the PC (Xbox 360)</string>
