# Интерактивная оболочка на отладочном порту (ttyFIQ0, 1500000 8n1).
#
# Служба console объявлена в init.rc, но выключена, а триггера
# `on property:ro.debuggable=1 / start console`, которым её запускает AOSP, в
# init.rc GammaOS нет - поэтому оболочки на порту не было.
#
# Консоль одна, и делить её не с кем: пока идёт загрузка, на неё пишет logcat
# (rg52logcat_con) - это главный инструмент, когда система не доходит до adb.
# После boot_completed adb уже есть, а вот интерактивная оболочка нужнее:
# именно на таком случае, когда экран чёрный и adb отвалился, её и не хватало.
# Поэтому переключаемся здесь, а не раньше.
#
# Выбор в свойстве persist.rg52.console: shell (по умолчанию) или logcat.

on property:sys.boot_completed=1 && property:persist.rg52.console=shell
    stop rg52logcat_con
    start console

on property:persist.rg52.console=shell
    stop rg52logcat_con
    start console

on property:persist.rg52.console=logcat
    stop console
    start rg52logcat_con

# Здесь была подстраховка, поднимавшая оверлей nano при выходе приложения
# (setprop sys.gammaos.nano.show_overlay 1 по app_launched=0). Она **убрана**:
# оказалось, что так делать нельзя.
#
# В самом nano (NanoMenu.cpp) прямым текстом описано, что происходит, если
# show_overlay поднят, а приложения на переднем плане нет: домашний экран
# решает, что его заслонили, и паркуется - отрисовка пропускается, ввод
# отбрасывается через drop_input, а sys.gammaos.nano.nav "never consumed".
# Самоисцеление там предусмотрено только для случая, когда резидентный оверлей
# ни разу не запускался; после первого же входа в приложение и выхода из него
# оно не работает, и "the home parks forever".
#
# Снаружи это выглядело так: в nano удержание выключателя перестало вызывать
# меню - просто ничего не происходило. PhoneWindowManager при видимом домашнем
# экране не поднимает оверлей, а выставляет sys.gammaos.nano.nav=powermenu, и
# именно этот признак запаркованный цикл и переставал читать.
