# RG52 Mini: применение режима производительности. Разбор — в самом скрипте,
# device/rg52mini/rg52-perf.sh.
#
# Имена служб не случайны: setclock_<режим> — это ровно то, что запускает
# через ctl.start код GammaOS (drastic-nano, NanoMenu). На устройствах, где
# такие службы приходят с vendor, этот файл лишний; у нас их нет, поэтому
# заводим свои со стороны system.
#
# Триггеры по свойству нужны отдельно: меню выключателя, плитка быстрых
# настроек и оболочка nano только пишут persist.gammaos.performance_mode и
# ничего не запускают — применение ожидается от vendor.

service setclock_stock /system/bin/rg52-perf.sh stock
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:shell:s0

service setclock_max /system/bin/rg52-perf.sh max
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:shell:s0

service setclock_powersave /system/bin/rg52-perf.sh powersave
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:shell:s0

service setclock_3d_game /system/bin/rg52-perf.sh 3d_game
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:shell:s0

service setclock_overclock /system/bin/rg52-perf.sh overclock
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:shell:s0

# Аргумент boot: скрипт сам выберет режим по источнику питания (со вставленной
# зарядкой max, от батареи stock) и запишет его в свойство. Служба нужна ещё и
# потому, что свойство persist.* к этому моменту уже восстановлено, но изменения
# его не было, а значит и триггер по свойству не сработал.
service rg52_perf_boot /system/bin/rg52-perf.sh boot
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:shell:s0

on property:persist.gammaos.performance_mode=stock
    start setclock_stock

on property:persist.gammaos.performance_mode=max
    start setclock_max

on property:persist.gammaos.performance_mode=powersave
    start setclock_powersave

on property:persist.gammaos.performance_mode=3d_game
    start setclock_3d_game

on property:persist.gammaos.performance_mode=overclock
    start setclock_overclock

on property:sys.boot_completed=1
    start rg52_perf_boot

# Интервал опроса геймпада задаётся вручную (persist.rg52.joypad.poll_ms) и
# применяется сразу: без аргумента скрипт заново применяет текущий режим, а с ним
# и интервал. До загрузки не нужно - тогда его применит rg52_perf_boot.
service rg52_perf_apply /system/bin/rg52-perf.sh
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:shell:s0

on property:persist.rg52.joypad.poll_ms=* && property:sys.boot_completed=1
    start rg52_perf_apply

# Счётчики планировщика. atrace.rc из AOSP включает их на late-init ради трасс
# perfetto («Scheduler tracepoints require schedstats»), и с этого момента каждое
# пробуждение и переключение потока ведёт статистику ожидания. Копейки (десятые
# доли процента), но постоянно и даром: трассы на этом устройстве снимают руками,
# и для них можно вернуть 1.
on property:sys.boot_completed=1
    write /proc/sys/kernel/sched_schedstats 0

# Ускоренные периоды RCU на время загрузки. Ядро и само работает так, пока не
# запустит init, а дальше переходит на обычные. Между тем самые долгие шаги init
# ждут именно конца периода RCU: закрытие устройств ввода, настройка loop- и
# dm-устройств под apex. Ускоренный период рассылает прерывания на все ядра,
# поэтому после загрузки обычный режим возвращается.
on early-init
    write /sys/kernel/rcu_expedited 1

on property:sys.boot_completed=1
    write /sys/kernel/rcu_expedited 0
