# adb remount: поднять overlay из /cache/overlay на каждой загрузке (см. rg52-overlay-mount.cpp).
#
# Триггер fs: mount_all вендора (init.rk30board.rc, импортирован из init.rc, поэтому его
# "on fs" идёт раньше нашего из /system/etc/init) уже смонтировал /cache, а bind-mount
# поверх /vendor/etc/usb_audio_policy_configuration.xml из gammaos.rc (post-fs) ещё не
# сделан: overlay ложится на чистые /system и /vendor, переносить подмонтирования не нужно.
# exec, а не служба: post-fs должен увидеть уже поднятый overlay.
# Домена su в сборке нет, поэтому shell (SELinux permissive).
on fs
    exec u:r:shell:s0 root root -- /system/bin/rg52-overlay-mount
