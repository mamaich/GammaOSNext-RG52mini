# RetroArch, PPSSPP, Flycast и Aurora Store из образа - на системы, установленные раньше
# (setup.sh ставит их только на первой загрузке), см. rg52-retroarch.sh. На новой установке
# скрипт видит те же APK и только ставит отметки.
service rg52_retroarch /system/bin/rg52-retroarch.sh
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:shell:s0

on property:sys.boot_completed=1 && property:persist.gammaos.setupwizard_done=1
    start rg52_retroarch
