# RG52 Mini: подкачка — zram с подложкой на карте и вытеснение по давлению.
# Разбор с измерениями — в самих скриптах, device/rg52mini/rg52-zram.sh и
# device/rg52mini/rg52-zram-wb.sh.

service rg52_zram /system/bin/rg52-zram.sh
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:shell:s0

service rg52_zram_wb /system/bin/rg52-zram-wb.sh
    user root
    group root system
    disabled
    seclabel u:r:shell:s0

# Настройка подкачки — на post-fs-data: /data уже смонтирована (подложка живёт
# там же, где файл подкачки GammaOS, в области, доступной до разблокировки), а
# zram к этому моменту уже поднят init-ом по vendor/etc/fstab.rk30board, и мы
# его переделываем.
on post-fs-data
    start rg52_zram

# Изменение любого из двух размеров применяется сразу, без перезагрузки.
on property:persist.rg52.zram.size_mb=*
    start rg52_zram

on property:persist.rg52.zram.algo=*
    start rg52_zram

# zswap настраивается тем же скриптом.
on property:persist.rg52.zswap.enabled=*
    start rg52_zram

on property:persist.rg52.zswap.max_pool_percent=*
    start rg52_zram

on property:persist.rg52.zswap.algo=*
    start rg52_zram

on property:persist.rg52.zram.backing_mb=*
    start rg52_zram

# Сторож вытеснения работает только при включённом экране: опрос раз в две
# секунды при погашенном мешал бы засыпанию, а смысла там нет.
on property:sys.screen.state=on
    start rg52_zram_wb

on property:sys.screen.state=off
    stop rg52_zram_wb

on property:persist.rg52.zram.wb_threshold_mb=*
    restart rg52_zram_wb
    start rg52_zram

# И ещё раз после загрузки. На том самом запуске, когда persist.sys.zram_enabled
# ещё равно 1, vendor успевает поднять zram по своему правилу уже после нас -
# здесь мы возвращаем всё к выбранной настройке.
on property:sys.boot_completed=1
    start rg52_zram

# Размеры тоже меняют смысл сторожа: подложка могла появиться или исчезнуть.
on property:persist.rg52.zram.backing_mb=*
    restart rg52_zram_wb

on property:persist.rg52.zram.size_mb=*
    restart rg52_zram_wb

# Файл подкачки уступает место только подложке zram, поэтому при любой смене
# настроек zram его надо переспросить: подложку могли выключить, и тогда файл
# нужно создать заново. Сам он этого не заметит - его служба (init.rc,
# gammaos_swap) просыпается только по изменению собственного размера.
on property:persist.rg52.zram.size_mb=*
    start gammaos_swap

on property:persist.rg52.zram.backing_mb=*
    start gammaos_swap

on property:persist.rg52.zram.wb_threshold_mb=*
    start gammaos_swap
