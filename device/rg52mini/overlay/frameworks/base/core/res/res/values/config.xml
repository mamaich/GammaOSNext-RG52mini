<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Запись страниц zram на постоянную память (zram writeback) выключена.

         Значение по умолчанию в AOSP - false, но раздел vendor от DOOGEE
         приносит свой RRO (/vendor/overlay/framework-res__auto_generated_rro_vendor.apk),
         который ставит true, и он перекрывает системный ресурс. Проверяется так:

             adb pull /vendor/overlay/framework-res__auto_generated_rro_vendor.apk
             aapt2 dump resources framework-res__auto_generated_rro_vendor.apk \
                 | grep -A1 zramWriteback

         Нам это не нужно по двум причинам. Во-первых, writeback гоняет страницы
         на флеш-память, а лишний износ eMMC или SD-карты на консоли того не
         стоит. Во-вторых, под своп на eMMC есть раздел всего на 256 МБ - выгоды
         от такого объёма всё равно нет. Сам zram при этом остаётся включённым,
         выключается только выгрузка на носитель.

         Побочно это же чинило падение в режиме nano: минимальная загрузка
         GammaOS не поднимает JobSchedulerService, а StorageManagerService при
         config_zramWriteback=true безусловно звал ZramWriteback, получал null и
         ронял system_server по кругу. В ZramWriteback добавлена проверка на
         null, но правильнее не включать то, чего мы не хотим. -->
    <bool name="config_zramWriteback">false</bool>

    <!-- Местоположение - без microG.

         Со значениями по умолчанию (true) LocationManagerService ищет провайдеров
         сети, fused и геокодера среди пакетов config_locationProviderPackageNames,
         а там первым стоит com.google.android.gms. Три привязки системы к GmsCore
         (каждой одной достаточно) держат его на уровне perceptible: процесс
         поднимается на загрузке вместе с оболочкой и не выгружается никогда -
         48 МБ PSS и 133 МБ RSS в простое. Проверено на устройстве: стоит отключить
         все три службы провайдеров, и GmsCore выгружается сам за 15 секунд.

         С false берутся пакеты по умолчанию из framework-res: fused - системный
         com.android.location.fused, он работает внутри system_server; провайдера
         сети и геокодера нет. На консоли без GPS и связи они не нужны. GmsCore
         при этом остаётся и поднимается по требованию: вход в аккаунт, Aurora
         Store, покупки в играх. -->
    <bool name="config_enableNetworkLocationOverlay">false</bool>
    <bool name="config_enableFusedLocationOverlay">false</bool>
    <bool name="config_enableGeocoderOverlay">false</bool>

    <!-- Без «фирменной клавиатуры».

         RRO из vendor (от SyachOS) задаёт config_packagedKeyboardName = "Pixel C
         Keyboard" - настройку планшета Pixel C с Bluetooth-клавиатурой. По ней
         KeyboardUI в SystemUI, пока не пройден мастер настройки
         (user_setup_complete = 0), сам включает Bluetooth, чтобы подключить
         клавиатуру. На чистой установке это перебивало def_bluetooth_on = false:
         Bluetooth включался через десяток секунд после загрузки
         («Enabled due to APPLICATION_REQUEST by com.android.systemui» в dumpsys
         bluetooth_manager). Пустое имя - KeyboardUI ничего не делает. Проверка:
         cmd overlay lookup android android:string/config_packagedKeyboardName -->
    <string name="config_packagedKeyboardName" translatable="false"></string>

    <!-- Наушники в гнезде 3,5 мм - через событие ввода.

         Гнездо видит драйвер звуковой карты (rockchip_multicodecs, hp-det-gpio
         GPIO0_A7): он сообщает о наушниках через snd_soc_jack, то есть
         устройством ввода «rockchip-rk817 Headset» с SW_HEADPHONE_INSERT и
         SW_MICROPHONE_INSERT. Ни switch h2w, ни extcon наушников у нас нет, а RRO из
         vendor ставит false - и WiredAccessoryManager о наушниках не узнавал вовсе:
         звук оставался на маршруте Speaker, аудио-HAL держал Playback Path = SPK, и
         кодек rk817 не выключал усилитель динамика (spk-ctl-gpios GPIO3_C3), пока
         вставлены наушники. С true система переключает вывод на проводные наушники,
         HAL ставит HP/HP_NO_MIC, и rk817_digital_mute_dac() гасит усилитель сам.
         Проверка: cmd overlay lookup android android:bool/config_useDevInputEventForAudioJack -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Одна громкость на все звуки.

         Ни телефонии, ни android.software.leanback у устройства нет, поэтому
         AudioService выбирал раскладку потоков обычного устройства: кнопки
         громкости меняют только музыку, а системные звуки, уведомления и будильник
         живут на своих громкостях (STREAM_SYSTEM сведён к STREAM_RING). Отсюда
         звук зарядки на полную громкость при музыке на нуле. С true потоки
         сводятся к STREAM_MUSIC (раскладка телевизора): один ползунок управляет
         всем, Settings и SystemUI сами прячут лишние ползунки. Режимы звонка
         (без звука, вибрация) при этом не действуют - на консоли они не нужны.
         Проверка: dumpsys audio | grep mIsSingleVolume -->
    <bool name="config_single_volume">true</bool>
</resources>
