<?xml version="1.0" encoding="utf-8"?>
<!--
    RG52 Mini: SBC кодеком A2DP по умолчанию вместо AAC.

    Штатные приоритеты в packages/modules/Bluetooth/android/app/res/values/config.xml:
    SBC 1001, AAC 2001, aptX 3001, aptX HD 4001, LDAC 5001 — побеждает
    наибольший, то есть AAC. Кодирование AAC на этом процессоре заметно
    дороже, а задержка звука на игровой консоли важнее качества потока.

    Понижаем AAC до 500: SBC выигрывает сам собой, при этом AAC остаётся
    доступным и его по-прежнему можно выбрать вручную в параметрах
    разработчика. Так же было сделано в порте Android 13, только там это был
    отдельный RRO-оверлей; здесь Bluetooth собирается из исходников, поэтому
    хватает подмены ресурса на этапе сборки.
-->
<resources>
    <integer name="a2dp_source_codec_priority_aac">500</integer>
</resources>
