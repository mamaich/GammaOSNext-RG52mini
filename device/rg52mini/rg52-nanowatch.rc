# Сторож пустого экрана в режиме nano. Разбор признаков и цена опроса - в самом
# скрипте, device/rg52mini/rg52-nanowatch.sh.
#
# Только в режиме nano: в обычном Android за пустым экраном есть лаунчер, и
# возвращаться неоткуда и незачем.
#
# Не oneshot: это цикл, и если он умрёт, init поднимет его заново. Группа
# graphics нужна для снимка экрана, домен shell - то окружение, в котором
# screencap заведомо работает.

service rg52_nanowatch /system/bin/rg52-nanowatch.sh
    user shell
    group shell graphics log readproc
    disabled
    seclabel u:r:shell:s0

on property:sys.gammaos.minimal_boot=1 && property:persist.rg52.nanowatch=1
    start rg52_nanowatch

on property:persist.rg52.nanowatch=0
    stop rg52_nanowatch
