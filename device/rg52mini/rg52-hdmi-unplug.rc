# Возврат встроенного экрана после отключения HDMI, см. rg52-hdmi-unplug.sh,
# и возврат HDMI после пробуждения, см. rg52-hdmi-rebind.sh.
#
# HWC пишет состояние HDMI в vendor.hwc.device.display-1
# (HDMI-A-1:<crtc>:connected / release / disconnected). Номер CRTC в значении
# может меняться, поэтому триггер на любую запись, а отключение распознаёт сам
# скрипт. Службы oneshot: повторный start во время их работы init игнорирует.

on property:vendor.hwc.device.display-1=*
    start rg52_hdmi_unplug

# Только по пробуждению: в другое время HWC отпускает HDMI лишь при отключении
# кабеля, и возвращать там нечего. Уход в сон ставит метку, включение экрана с
# меткой запускает службу. В конце загрузки, пока рисуется оболочка, HWC порой
# несколько секунд держит HDMI на видеопорту без плоскостей и справляется сам -
# там служба не нужна, а переподключение лишь моргнуло бы телевизором.
on property:sys.screen.state=off && property:sys.boot_completed=1
    setprop sys.rg52.screen_was_off 1

on property:sys.screen.state=on && property:sys.rg52.screen_was_off=1
    setprop sys.rg52.screen_was_off 0
    start rg52_hdmi_rebind

# wakelock: запись в /sys/power/wake_lock (radio:wakelock 0660) на время
# «сна-пробуждения».
service rg52_hdmi_unplug /system/bin/rg52-hdmi-unplug.sh
    user shell
    group shell wakelock
    disabled
    oneshot
    seclabel u:r:shell:s0

# root: запись в /sys/class/drm/card0-HDMI-A-1/status и /sys/power/wake_lock.
# Пробуждение, пришедшее, пока служба ещё работает, init второй раз её не
# запустит - его разбирает работающий экземпляр (повторная проверка после
# переподключения).
service rg52_hdmi_rebind /system/bin/rg52-hdmi-rebind.sh
    user root
    group root shell
    disabled
    oneshot
    seclabel u:r:shell:s0
