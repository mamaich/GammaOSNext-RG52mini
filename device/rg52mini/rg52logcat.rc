# RG52 Mini: logcat в последовательную консоль.
#
# Перенесено из порта Android 13, где это лежало в разделе system. Ключевое
# слово console привязывает вывод службы к /dev/console, а /dev/console — это
# ttyFIQ0 (uart0, 1500000), потому что в extlinux.conf других console= нет.
#
# Отличие от оригинала: seclabel u:r:shell:s0 вместо u:r:su:s0 — домена su в
# сборке без root не существует, и init отказался бы запускать службу.

service rg52logcat_con /system/bin/logcat -b all -v threadtime
    class main
    user root
    group root system log
    seclabel u:r:shell:s0
    console

# Запись журнала в файл на /metadata (служба rg52logcat_file) убрана. Она
# держала до трёх файлов по 4 МБ на разделе в 11 МБ: раздел заполнялся до
# 98 %, logcat упирался в нехватку места, завершался, и init перезапускал его
# каждые 5 секунд. А /metadata не свалка: там ключи шифрования userdata и
# состояние OTA. Файлы, оставшиеся от прежних сборок, удаляются здесь же.

# Намеренно post-fs, а не post-fs-data: именно в post-fs-data чаще всего и
# застревает загрузка (там perform_apex_config, wait_for_prop apexd.status и
# прочее), а лог нужен раньше, чем она туда дойдёт. logd к этому моменту уже
# поднят: он стартует по триггеру fs.
on post-fs
    start rg52logcat_con
    rm /metadata/rg52_logcat.txt
    rm /metadata/rg52_logcat.txt.1
    rm /metadata/rg52_logcat.txt.2
